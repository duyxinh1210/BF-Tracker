local function refreshLocal()

	State.Account.Username =
		Player.Name

	State.Account.DisplayName =
		Player.DisplayName

	State.Account.UserId =
		Player.UserId

	State.Account.Level =
		valueOf(Data, "Level")

	State.Account.Beli =
		valueOf(Data, "Beli")

	State.Account.Fragments =
		valueOf(Data, "Fragments")

	State.Account.Exp =
		valueOf(Data, "Exp")

	State.Account.DevilFruit =
		valueOf(
			Data,
			"DevilFruit"
		)

	State.Account.PlaceId =
		game.PlaceId

	State.Account.JobId =
		game.JobId


    ------------------------------------------------------
    -- Pull Lever
    --
    -- DO NOT overwrite it here from Player.Data.
    -- No reliable replicated Player.Data field was found.
    -- It is refreshed by CheckTempleDoor on each successful
    -- FULL refresh (45s) below.
    ------------------------------------------------------

    State.Account.ASkills =
        findDataValueByNames(
            Data,
            {
                "ASkills",
                "A.Skills",
                "AwakeningSkills"
            },
            nil
        )

	------------------------------------------------------
	-- BOUNTY
	------------------------------------------------------

	local leaderstats =
		Player:FindFirstChild(
			"leaderstats"
		)

	if leaderstats then

		State.Account.BountyHonor =
			valueOf(
				leaderstats,
				"Bounty/Honor"
			)

	end

	------------------------------------------------------
	-- RACE LOCAL VALUES
	------------------------------------------------------

	State.Race.Name =
		Race.Value

	State.Race.A =
		valueOf(Race, "A")

	State.Race.B =
		valueOf(Race, "B")

	State.Race.C =
		valueOf(Race, "C")

	------------------------------------------------------
	-- If full scan already knows Evolution,
	-- keep V4 Tier live from Race.C
	------------------------------------------------------

	if State.Race.Version == 4 then

		State.Race.Tier =
			State.Race.C

		State.Race.Display =
			string.format(
				"%s V4 T%s",
				State.Race.Name,
				tostring(
					State.Race.Tier
					or "?"
				)
			)

	elseif State.Race.Version then

		State.Race.Tier =
			nil

		State.Race.Display =
			string.format(
				"%s V%s",
				State.Race.Name,
				tostring(
					State.Race.Version
				)
			)

	end

	State.Stats.LastLocalUpdate =
		os.time()

end

----------------------------------------------------------
-- FULL REMOTE REFRESH
----------------------------------------------------------

local function refreshFull()

	local started =
		os.clock()

	State.Status =
		"REFRESHING"

	local ok, raw =
		pcall(function()

			return
				GetAll:
				InvokeServer()

		end)

	if
		not ok
		or
		typeof(raw) ~= "table"
		or
		next(raw) == nil
	then

		State.Status =
			State.Ready
			and
			"READY"
			or
			"WAITING_DATA"

		State.Stats.LastError =
			tostring(raw)

		warn(
			"[BF V11.9] FULL refresh failed:",
			State.Stats.LastError
		)

		return false

	end

	------------------------------------------------------
	-- GROUP
	------------------------------------------------------

	local grouped =
		groupRecords(raw)

	------------------------------------------------------
	-- CURRENT RACE
	------------------------------------------------------

	local raceItem =
		findRaceItem(grouped)

	local evolution =
		nil

	if
		raceItem
		and
		raceItem.Properties
		and
		typeof(
			raceItem.Properties.Evolution
		) == "number"
	then

		evolution =
			raceItem.Properties.Evolution

	end

	------------------------------------------------------
	-- IMPORTANT:
	-- Inventory must NEVER be blocked by missing Evolution.
	-- V3 accounts can have valid GetAllItemValues data while
	-- the current race record has no numeric Evolution field.
	------------------------------------------------------

	local raceLevel, raceLevelError =
		queryRaceLevel()

	State.Stats.RaceLevelLastCheck =
		os.time()

	State.Stats.RaceLevelLastError =
		raceLevelError

	local raceVersion =
		raceLevel
		or
		evolution

	------------------------------------------------------
	-- INVENTORY
	------------------------------------------------------

	local Inventory = {

		Melee = {},
		Swords = {},
		Guns = {},
		StoredFruits = {},
		Accessories = {},
		Materials = {},
		Races = {}

	}

	local CurrentFruit =
		nil

	local currentFruitName =
		tostring(
			valueOf(
				Data,
				"DevilFruit"
			)
			or
			""
		)

	for id, item in pairs(grouped) do

		local meta =
			getMeta(id)

		--------------------------------------------------
		-- CURRENT FRUIT
		--------------------------------------------------

		if
			sameFruit(
				meta.Name,
				currentFruitName
			)
			and
			(
				item.Properties.Mastery ~= nil
				or
				item.Properties.IsEquipped == true
			)
		then

			local candidate =
				cleanItem(
					item,
					meta
				)

			if
				not CurrentFruit
				or
				(
					candidate.IsEquipped
					and
					not CurrentFruit.IsEquipped
				)
				or
				(
					(candidate.Mastery or 0)
					>
					(CurrentFruit.Mastery or 0)
				)
			then

				CurrentFruit =
					candidate

			end

		end

		--------------------------------------------------
		-- OWNED INVENTORY
		--------------------------------------------------

		if strictOwned(item) then

			local category =
				categoryOf(
					item,
					meta
				)

			if
				category
				and
				Inventory[category]
			then

				table.insert(
					Inventory[category],
					cleanItem(
						item,
						meta
					)
				)

			end

		end

	end

	------------------------------------------------------
	-- SORT
	------------------------------------------------------

	for _, list in pairs(Inventory) do

		table.sort(
			list,
			function(a, b)

				return
					lower(a.Name)
					<
					lower(b.Name)

			end
		)

	end

	------------------------------------------------------
	-- EQUIPPED
	------------------------------------------------------

	local function findEquipped(list)

		for _, item in ipairs(list) do

			if item.IsEquipped then
				return item
			end

		end

		return nil

	end

	------------------------------------------------------
	-- APPLY STATE
	------------------------------------------------------

	State.Inventory =
		Inventory

	State.CurrentFruit =
		CurrentFruit

	State.Equipped = {

		Melee =
			findEquipped(
				Inventory.Melee
			),

		Sword =
			findEquipped(
				Inventory.Swords
			),

		Gun =
			findEquipped(
				Inventory.Guns
			),

		Race =
			findEquipped(
				Inventory.Races
			),

		Fruit =
			CurrentFruit

	}

	State.Race.Name =
		Race.Value

	State.Race.Version =
		raceVersion

	State.Race.Evolution =
		evolution

	State.Race.A =
		valueOf(Race, "A")

	State.Race.B =
		valueOf(Race, "B")

	State.Race.C =
		valueOf(Race, "C")

	------------------------------------------------------
	-- PULL LEVER
	--
	-- Server-side status query confirmed against:
	--   true  -> account shown as "Đã gạt cần"
	--   false -> account shown as "Chưa gạt cần"
	--
	-- Failure/unexpected result stays nil so the app
	-- renders "?" instead of guessing.
	------------------------------------------------------

	local pullLever, pullLeverError =
		queryPullLever()

	State.Account.PullLever =
		pullLever

	State.Stats.PullLeverLastCheck =
		os.time()

	State.Stats.PullLeverLastError =
		pullLeverError

	if raceVersion == 4 then

		State.Race.Tier =
			State.Race.C

		State.Race.Display =
			string.format(
				"%s V4 T%s",
				Race.Value,
				tostring(
					State.Race.Tier
					or "?"
				)
			)

	else

		State.Race.Tier =
			nil

		State.Race.Display =
			string.format(
				"%s V%s",
				Race.Value,
				tostring(
					evolution
				)
			)

	end

	State.Ready =
		true

	State.Status =
		"READY"

	State.Revision += 1

	State.Stats.FullRefreshes += 1

	State.Stats.RawRecords =
		countTable(raw)

	State.Stats.UniqueItemIds =
		countTable(grouped)

	State.Stats.LastFullDuration =
		os.clock() - started

	State.Stats.LastFullUpdate =
		os.time()

	State.Stats.LastError =
		nil

	------------------------------------------------------
	-- Send complete fresh data immediately
	------------------------------------------------------

	task.spawn(
		sendToApp
	)

	------------------------------------------------------
	-- OUTPUT
	------------------------------------------------------

	print(
		string.format(
			"[BF V11.9] UPDATE #%d | %.3fs | %s | RaceLevel:%s | Evo:%s | PL:%s | Fruits:%d Sword:%d Melee:%d",
			State.Revision,
			State.Stats.LastFullDuration,
			State.Race.Display
				or "?",
			tostring(
				raceLevel
				or "?"
			),
			tostring(
				evolution
				or "?"
			),
			State.Account.PullLever == true
				and "YES"
				or
				(
					State.Account.PullLever == false
					and "NO"
					or "?"
				),
			#Inventory.StoredFruits,
			#Inventory.Swords,
			#Inventory.Melee
		)
	)

	return true

end

----------------------------------------------------------
-- INITIAL LOCAL
----------------------------------------------------------

refreshLocal()

print(
	"[BF V11.9] Continuous tracker started"
)

print(
	"[BF V11.9] Full refresh:",
	FULL_INTERVAL,
	"seconds"
)

print(
	"[BF V11.9] App sync:",
	APP_URL
)

----------------------------------------------------------
-- MAIN LOOP
----------------------------------------------------------

local nextFull =
	0

local nextAppSend =
	0

while
	ENV.BF_TRACKER_V11_9_INSTANCE
	==
	RUN_ID
do

	------------------------------------------------------
	-- LOCAL DATA EVERY 1 SECOND
	------------------------------------------------------

	refreshLocal()

	------------------------------------------------------
	-- SEND CURRENT STATE TO LOCAL APP
	--
	-- Before first full scan this gives the app
	-- username/level/beli/etc. as soon as possible.
	-- After first full scan it keeps the full inventory
	-- plus live local stats updated.
	------------------------------------------------------

	if os.clock() >= nextAppSend then

		task.spawn(
			sendToApp
		)

		nextAppSend =
			os.clock()
			+
			APP_SEND_INTERVAL

	end

	------------------------------------------------------
	-- FULL DATA
	------------------------------------------------------

	if os.clock() >= nextFull then

		local success =
			refreshFull()

		if success then

			nextFull =
				os.clock()
				+
				FULL_INTERVAL

		else

			if State.Ready then

				nextFull =
					os.clock()
					+
					FULL_INTERVAL

			else

				nextFull =
					os.clock()
					+
					INITIAL_RETRY

			end

		end

	end

	task.wait(
		LOCAL_INTERVAL
	)

end

print(
	"[BF V11.9] This V11.9 instance stopped because another V11.9 instance started"
)
